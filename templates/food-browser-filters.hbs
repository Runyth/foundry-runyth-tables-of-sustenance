<aside class="rts-filter-panel">
  <form class="rts-browser-filters" autocomplete="off">
    <label class="rts-wide"><span>{{localize "runyth-tables-of-sustenance.Browser.Search"}}</span><input type="search" name="search" value="{{filters.search}}" placeholder="{{localize 'runyth-tables-of-sustenance.Browser.SearchPlaceholder'}}"></label>
    <label><span>{{localize "runyth-tables-of-sustenance.Browser.Tier"}}</span><select name="tier"><option value="*">{{localize "runyth-tables-of-sustenance.Common.All"}}</option>{{#each options.tiers}}<option value="{{this}}" {{#if (eq ../filters.tier this)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
    <label><span>{{localize "runyth-tables-of-sustenance.Browser.Region"}}</span><select name="region"><option value="*">{{localize "runyth-tables-of-sustenance.Common.All"}}</option>{{#each options.regions}}<option value="{{this}}" {{#if (eq ../filters.region this)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
    <label><span>{{localize "runyth-tables-of-sustenance.Browser.Venue"}}</span><select name="venue"><option value="*">{{localize "runyth-tables-of-sustenance.Common.All"}}</option>{{#each options.venues}}<option value="{{this}}" {{#if (eq ../filters.venue this)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
    <label><span>{{localize "runyth-tables-of-sustenance.Browser.Consumer"}}</span><select name="consumer"><option value="*">{{localize "runyth-tables-of-sustenance.Common.All"}}</option>{{#each options.consumers}}<option value="{{this}}" {{#if (eq ../filters.consumer this)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
    <label><span>{{localize "runyth-tables-of-sustenance.Browser.Culture"}}</span><select name="culture"><option value="*">{{localize "runyth-tables-of-sustenance.Common.All"}}</option>{{#each options.cultures}}<option value="{{this}}" {{#if (eq ../filters.culture this)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
    <label><span>{{localize "runyth-tables-of-sustenance.Browser.Faction"}}</span><select name="faction"><option value="*">{{localize "runyth-tables-of-sustenance.Common.All"}}</option>{{#each options.factions}}<option value="{{this}}" {{#if (eq ../filters.faction this)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
    <label><span>{{localize "runyth-tables-of-sustenance.Browser.SocialClass"}}</span><select name="socialClass"><option value="*">{{localize "runyth-tables-of-sustenance.Common.All"}}</option>{{#each options.socialClasses}}<option value="{{this}}" {{#if (eq ../filters.socialClass this)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
    <label><span>{{localize "runyth-tables-of-sustenance.Browser.Rarity"}}</span><select name="rarity"><option value="*">{{localize "runyth-tables-of-sustenance.Common.All"}}</option>{{#each options.rarities}}<option value="{{this}}" {{#if (eq ../filters.rarity this)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
    <label><span>{{localize "runyth-tables-of-sustenance.Browser.Price"}}</span><select name="price"><option value="*">{{localize "runyth-tables-of-sustenance.Common.All"}}</option>{{#each options.prices}}<option value="{{this}}" {{#if (eq ../filters.price this)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
    <label><span>{{localize "runyth-tables-of-sustenance.Browser.Legality"}}</span><select name="legality"><option value="*">{{localize "runyth-tables-of-sustenance.Common.All"}}</option>{{#each options.legalities}}<option value="{{this}}" {{#if (eq ../filters.legality this)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
    <label><span>{{localize "runyth-tables-of-sustenance.Browser.Nature"}}</span><select name="nature"><option value="*">{{localize "runyth-tables-of-sustenance.Common.All"}}</option>{{#each options.natures}}<option value="{{this}}" {{#if (eq ../filters.nature this)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
    <label><span>{{localize "runyth-tables-of-sustenance.Browser.Dietary"}}</span><select name="dietary"><option value="*">{{localize "runyth-tables-of-sustenance.Common.All"}}</option>{{#each options.dietary}}<option value="{{this}}" {{#if (eq ../filters.dietary this)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
    <label><span>{{localize "runyth-tables-of-sustenance.Browser.ActiveEffect"}}</span><select name="activeEffect"><option value="*">{{localize "runyth-tables-of-sustenance.Common.All"}}</option><option value="yes" {{#if (eq filters.activeEffect "yes")}}selected{{/if}}>{{localize "runyth-tables-of-sustenance.Common.Yes"}}</option><option value="no" {{#if (eq filters.activeEffect "no")}}selected{{/if}}>{{localize "runyth-tables-of-sustenance.Common.No"}}</option></select></label>
    <label><span>{{localize "runyth-tables-of-sustenance.Browser.Cooldown"}}</span><select name="cooldown"><option value="*">{{localize "runyth-tables-of-sustenance.Common.All"}}</option><option value="yes" {{#if (eq filters.cooldown "yes")}}selected{{/if}}>{{localize "runyth-tables-of-sustenance.Common.Yes"}}</option><option value="no" {{#if (eq filters.cooldown "no")}}selected{{/if}}>{{localize "runyth-tables-of-sustenance.Common.No"}}</option></select></label>
    <label><span>{{localize "runyth-tables-of-sustenance.Browser.Sort"}}</span><select name="sort"><option value="name">{{localize "runyth-tables-of-sustenance.Browser.Name"}}</option><option value="price" {{#if (eq filters.sort "price")}}selected{{/if}}>{{localize "runyth-tables-of-sustenance.Browser.Price"}}</option><option value="origin" {{#if (eq filters.sort "origin")}}selected{{/if}}>{{localize "runyth-tables-of-sustenance.Browser.Origin"}}</option><option value="rarity" {{#if (eq filters.sort "rarity")}}selected{{/if}}>{{localize "runyth-tables-of-sustenance.Browser.Rarity"}}</option><option value="tier" {{#if (eq filters.sort "tier")}}selected{{/if}}>{{localize "runyth-tables-of-sustenance.Browser.Tier"}}</option><option value="preparationTime" {{#if (eq filters.sort "preparationTime")}}selected{{/if}}>{{localize "runyth-tables-of-sustenance.Browser.PreparationTime"}}</option><option value="duration" {{#if (eq filters.sort "duration")}}selected{{/if}}>{{localize "runyth-tables-of-sustenance.Browser.Duration"}}</option></select></label>
  </form>
  <div class="rts-filter-actions"><button type="button" data-action="reset"><i class="fa-solid fa-rotate-left"></i><span>{{localize "runyth-tables-of-sustenance.Browser.Reset"}}</span></button><button type="button" data-action="savePreset"><i class="fa-solid fa-bookmark"></i><span>{{localize "runyth-tables-of-sustenance.Browser.SavePreset"}}</span></button></div>
  {{#if presets.length}}<div class="rts-presets"><strong>{{localize "runyth-tables-of-sustenance.Browser.Presets"}}</strong>{{#each presets}}<button type="button" data-action="loadPreset" data-preset-id="{{id}}">{{name}}</button>{{/each}}</div>{{/if}}
</aside>
