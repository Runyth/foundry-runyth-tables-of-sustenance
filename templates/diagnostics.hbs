<div class="rts-diagnostics-scroll">
  <header class="rts-section-header"><div><h1>{{localize "runyth-tables-of-sustenance.Diagnostics.Title"}}</h1><p>{{localize "runyth-tables-of-sustenance.Diagnostics.Intro"}}</p></div><div class="rts-action-row"><button type="button" data-action="run" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-rotate"></i><span>{{localize "runyth-tables-of-sustenance.Diagnostics.Run"}}</span></button>{{#if report}}<button type="button" data-action="export"><i class="fa-solid fa-file-export"></i><span>{{localize "runyth-tables-of-sustenance.Diagnostics.Export"}}</span></button>{{/if}}</div></header>
  {{#if report}}<section class="rts-diagnostic-summary {{#if report.summary.ok}}ok{{else}}problem{{/if}}"><span><strong>{{report.summary.errors}}</strong>{{localize "runyth-tables-of-sustenance.Diagnostics.Errors"}}</span><span><strong>{{report.summary.warnings}}</strong>{{localize "runyth-tables-of-sustenance.Diagnostics.Warnings"}}</span><span><strong>{{report.content.foods}}</strong>{{localize "runyth-tables-of-sustenance.Manager.Foods"}}</span><span><strong>{{report.extensions.foods}}</strong>{{localize "runyth-tables-of-sustenance.Dashboard.ExtensionFoods"}}</span><span><strong>{{report.imageOverrides}}</strong>{{localize "runyth-tables-of-sustenance.Diagnostics.ImageOverrides"}}</span></section><section class="rts-tool-panel"><h2>{{localize "runyth-tables-of-sustenance.Diagnostics.Environment"}}</h2><dl class="rts-definition-grid"><dt>Foundry</dt><dd>{{report.foundry.version}}</dd><dt>System</dt><dd>{{report.system.id}} {{report.system.version}}</dd><dt>{{localize "runyth-tables-of-sustenance.Diagnostics.Generated"}}</dt><dd>{{report.generatedAt}}</dd></dl></section><section class="rts-tool-panel"><h2>{{localize "runyth-tables-of-sustenance.Diagnostics.Findings"}}</h2>{{#if report.findings.length}}<div class="rts-finding-list">{{#each report.findings}}<article class="rts-finding {{severity}}"><span class="rts-severity">{{severity}}</span><div><strong>{{code}}</strong><p>{{message}}</p></div></article>{{/each}}</div>{{else}}<p class="rts-success"><i class="fa-solid fa-circle-check"></i>{{localize "runyth-tables-of-sustenance.Diagnostics.NoFindings"}}</p>{{/if}}</section>{{else}}<p class="rts-empty">{{localize "runyth-tables-of-sustenance.Diagnostics.NotRun"}}</p>{{/if}}
</div>
