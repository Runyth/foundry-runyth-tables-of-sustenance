<div class="rts-benefit-manager">
  <header><h1>{{actor.name}}</h1><p>{{localize "runyth-tables-of-sustenance.Benefits.Intro"}}</p></header>
  {{#if primed}}<section class="notification warning"><strong>{{localize "runyth-tables-of-sustenance.Benefits.Primed"}}</strong> {{primed.name}} (+{{primed.bonus}}; {{primed.context}}) <button type="button" data-action="unprime">{{localize "runyth-tables-of-sustenance.Benefits.Unprime"}}</button></section>{{/if}}
  <section><h2>{{localize "runyth-tables-of-sustenance.Benefits.Permanent"}}</h2>{{#if benefits.length}}<div class="rts-benefit-list">{{#each benefits}}<article data-effect-id="{{effectId}}"><div><strong>{{name}}</strong><p>{{summary}}</p>{{#if contextual}}<small>{{context}}</small>{{/if}}</div><div>{{#if contextual}}<button type="button" data-action="prime"><i class="fa-solid fa-bolt"></i>{{localize "runyth-tables-of-sustenance.Benefits.Prime"}}</button>{{/if}}{{#if ../isGM}}<button type="button" data-action="remove" class="danger"><i class="fa-solid fa-trash"></i>{{localize "runyth-tables-of-sustenance.Common.Remove"}}</button>{{/if}}</div></article>{{/each}}</div>{{else}}<p class="rts-empty">{{localize "runyth-tables-of-sustenance.Benefits.None"}}</p>{{/if}}</section>
  <section><h2>{{localize "runyth-tables-of-sustenance.Benefits.Cooldowns"}}</h2>{{#if cooldowns.length}}<ul>{{#each cooldowns}}<li><code>{{id}}</code> — {{remaining}}</li>{{/each}}</ul>{{else}}<p class="rts-empty">{{localize "runyth-tables-of-sustenance.Benefits.NoCooldowns"}}</p>{{/if}}{{#if isGM}}<button type="button" data-action="clearCooldowns">{{localize "runyth-tables-of-sustenance.Benefits.ClearCooldowns"}}</button>{{/if}}</section>
</div>
