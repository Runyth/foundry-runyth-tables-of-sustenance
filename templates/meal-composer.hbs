<div class="obts-composer-layout">
  <form class="obts-composer-form">
    <p>{{localize "runyth-tables-of-sustenance.Composer.Intro"}}</p>
    <div class="obts-meal-slots">{{#each selected}}<label><span>{{localize labelKey}}</span><select name="{{slot}}"><option value="">{{localize "runyth-tables-of-sustenance.Common.None"}}</option>{{#each ../options}}<option value="{{sourceId}}" {{#if (eq ../sourceId sourceId)}}selected{{/if}}>[{{tier}}] {{name}}</option>{{/each}}</select></label>{{/each}}</div>
    <label><span>{{localize "runyth-tables-of-sustenance.Composer.StackingRule"}}</span><select name="rule"><option value="strongest" {{#if (eq rule "strongest")}}selected{{/if}}>{{localize "runyth-tables-of-sustenance.Settings.Stacking.Strongest"}}</option><option value="onePerTier" {{#if (eq rule "onePerTier")}}selected{{/if}}>{{localize "runyth-tables-of-sustenance.Composer.OnePerTier"}}</option><option value="all" {{#if (eq rule "all")}}selected{{/if}}>{{localize "runyth-tables-of-sustenance.Composer.AllEffects"}}</option><option value="narrative" {{#if (eq rule "narrative")}}selected{{/if}}>{{localize "runyth-tables-of-sustenance.Composer.NarrativeOnly"}}</option></select></label>
  </form>
  <section><h2>{{localize "runyth-tables-of-sustenance.Composer.EffectPreview"}}</h2>{{#if effects.length}}<ul class="obts-effect-list">{{#each effects}}<li><span class="obts-tier">{{tier}}</span><strong>{{name}}</strong><span>{{summary}}</span></li>{{/each}}</ul>{{else}}<p class="obts-empty">{{localize "runyth-tables-of-sustenance.Composer.NoFood"}}</p>{{/if}}<h3>{{localize "runyth-tables-of-sustenance.Composer.AppliedEffects"}}</h3>{{#if applied.length}}<ul>{{#each applied}}<li>{{name}} — {{summary}}</li>{{/each}}</ul>{{else}}<p>{{localize "runyth-tables-of-sustenance.Composer.NoMechanicalEffects"}}</p>{{/if}}</section>
  <footer class="form-footer"><button type="button" data-action="clear"><i class="fa-solid fa-eraser"></i>{{localize "runyth-tables-of-sustenance.Common.Clear"}}</button><button type="button" data-action="consume"><i class="fa-solid fa-utensils"></i>{{localize "runyth-tables-of-sustenance.Common.Consume"}}</button></footer>
</div>
