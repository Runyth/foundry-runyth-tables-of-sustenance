<main class="obts-results">
  <header class="obts-results-header"><span>{{localize "runyth-tables-of-sustenance.Browser.ResultCount" count=total}}</span><div class="obts-icon-actions"><button type="button" data-action="cards" class="icon" title="{{localize 'runyth-tables-of-sustenance.Browser.CardView'}}" aria-label="{{localize 'runyth-tables-of-sustenance.Browser.CardView'}}"><i class="fa-solid fa-grip"></i></button><button type="button" data-action="table" class="icon" title="{{localize 'runyth-tables-of-sustenance.Browser.TableView'}}" aria-label="{{localize 'runyth-tables-of-sustenance.Browser.TableView'}}"><i class="fa-solid fa-table-list"></i></button></div></header>
  {{#if cardView}}<div class="obts-food-grid">{{#each results}}<article class="obts-food-card tier-{{tier}}" data-source-id="{{sourceId}}" data-food-source-id="{{sourceId}}" {{#if ../isGM}}draggable="true"{{/if}}><div class="obts-food-image-wrap"><img src="{{img}}" alt="{{name}}">{{#if ../isGM}}<div class="obts-image-actions"><button type="button" data-action="changeImage" class="icon" title="{{localize 'runyth-tables-of-sustenance.Browser.ChangeImage'}}" aria-label="{{localize 'runyth-tables-of-sustenance.Browser.ChangeImage'}}"><i class="fa-solid fa-image"></i></button>{{#if imageOverridden}}<button type="button" data-action="resetImage" class="icon" title="{{localize 'runyth-tables-of-sustenance.Browser.ResetImage'}}" aria-label="{{localize 'runyth-tables-of-sustenance.Browser.ResetImage'}}"><i class="fa-solid fa-rotate-left"></i></button>{{/if}}</div>{{/if}}</div><div class="obts-food-body"><div class="obts-food-title"><h2>{{name}}</h2><span class="obts-tier">{{tier}}</span></div><p class="obts-origin">{{settlement}} · {{region}}</p><p class="obts-summary">{{summary}}</p><dl><dt>{{localize "runyth-tables-of-sustenance.Browser.Price"}}</dt><dd>{{price}}</dd><dt>{{localize "runyth-tables-of-sustenance.Browser.Rarity"}}</dt><dd>{{rarity}}</dd><dt>{{localize "runyth-tables-of-sustenance.Browser.Servings"}}</dt><dd>{{servings}}</dd></dl><div class="obts-card-actions"><button type="button" data-action="preview">{{localize "runyth-tables-of-sustenance.Common.Preview"}}</button>{{#if ../isGM}}<button type="button" data-action="give" {{#unless ../adapterAvailable}}disabled{{/unless}}>{{localize "runyth-tables-of-sustenance.Common.Add"}}</button><button type="button" data-action="consume" {{#unless ../adapterAvailable}}disabled{{/unless}}>{{localize "runyth-tables-of-sustenance.Common.Consume"}}</button><button type="button" data-action="serve" {{#unless ../adapterAvailable}}disabled{{/unless}}>{{localize "runyth-tables-of-sustenance.Common.ServeSelected"}}</button>{{/if}}</div></div></article>{{/each}}</div>{{/if}}
  {{#if tableView}}<div class="obts-table-scroll"><table><thead><tr><th>{{localize "runyth-tables-of-sustenance.Browser.Name"}}</th><th>{{localize "runyth-tables-of-sustenance.Browser.Tier"}}</th><th>{{localize "runyth-tables-of-sustenance.Browser.Origin"}}</th><th>{{localize "runyth-tables-of-sustenance.Browser.Price"}}</th><th>{{localize "runyth-tables-of-sustenance.Browser.Rarity"}}</th><th>{{localize "runyth-tables-of-sustenance.Common.Actions"}}</th></tr></thead><tbody>{{#each results}}<tr data-source-id="{{sourceId}}" data-food-source-id="{{sourceId}}" {{#if ../isGM}}draggable="true"{{/if}}><td><div class="obts-table-food"><img src="{{img}}" alt=""><span>{{name}}</span></div></td><td>{{tier}}</td><td>{{settlement}}, {{region}}</td><td>{{price}}</td><td>{{rarity}}</td><td><div class="obts-icon-actions"><button type="button" data-action="preview" class="icon" title="{{localize 'runyth-tables-of-sustenance.Common.Preview'}}" aria-label="{{localize 'runyth-tables-of-sustenance.Common.Preview'}}"><i class="fa-solid fa-eye"></i></button>{{#if ../isGM}}<button type="button" data-action="give" {{#unless ../adapterAvailable}}disabled{{/unless}} class="icon" title="{{localize 'runyth-tables-of-sustenance.Common.Add'}}" aria-label="{{localize 'runyth-tables-of-sustenance.Common.Add'}}"><i class="fa-solid fa-plus"></i></button><button type="button" data-action="consume" {{#unless ../adapterAvailable}}disabled{{/unless}} class="icon" title="{{localize 'runyth-tables-of-sustenance.Common.Consume'}}" aria-label="{{localize 'runyth-tables-of-sustenance.Common.Consume'}}"><i class="fa-solid fa-utensils"></i></button><button type="button" data-action="serve" {{#unless ../adapterAvailable}}disabled{{/unless}} class="icon" title="{{localize 'runyth-tables-of-sustenance.Common.ServeSelected'}}" aria-label="{{localize 'runyth-tables-of-sustenance.Common.ServeSelected'}}"><i class="fa-solid fa-people-group"></i></button>{{/if}}{{#if ../isGM}}<button type="button" data-action="changeImage" class="icon" title="{{localize 'runyth-tables-of-sustenance.Browser.ChangeImage'}}" aria-label="{{localize 'runyth-tables-of-sustenance.Browser.ChangeImage'}}"><i class="fa-solid fa-image"></i></button>{{#if imageOverridden}}<button type="button" data-action="resetImage" class="icon" title="{{localize 'runyth-tables-of-sustenance.Browser.ResetImage'}}" aria-label="{{localize 'runyth-tables-of-sustenance.Browser.ResetImage'}}"><i class="fa-solid fa-rotate-left"></i></button>{{/if}}{{/if}}</div></td></tr>{{/each}}</tbody></table></div>{{/if}}
  <footer class="obts-pagination"><button type="button" data-action="previous" title="{{localize 'runyth-tables-of-sustenance.Common.Previous'}}" aria-label="{{localize 'runyth-tables-of-sustenance.Common.Previous'}}" {{#unless hasPrevious}}disabled{{/unless}}><i class="fa-solid fa-chevron-left"></i></button><span>{{localize "runyth-tables-of-sustenance.Browser.Page" page=page pages=pages}}</span><button type="button" data-action="next" title="{{localize 'runyth-tables-of-sustenance.Common.Next'}}" aria-label="{{localize 'runyth-tables-of-sustenance.Common.Next'}}" {{#unless hasNext}}disabled{{/unless}}><i class="fa-solid fa-chevron-right"></i></button></footer>
</main>
