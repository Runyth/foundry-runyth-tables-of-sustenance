<div class="obts-window-geometry-scroll">
  <header class="obts-section-header">
    <div>
      <h1>{{localize "runyth-tables-of-sustenance.WindowGeometry.Title"}}</h1>
      <p>{{localize "runyth-tables-of-sustenance.WindowGeometry.Intro"}}</p>
    </div>
  </header>
  <section class="obts-tool-panel">
    <p>{{localize "runyth-tables-of-sustenance.WindowGeometry.Saved" count=savedWindows}}</p>
    <div class="obts-action-grid">
      <button type="button" data-action="resetSizes"><i class="fa-solid fa-expand"></i><span>{{localize "runyth-tables-of-sustenance.Common.ResetSize"}}</span></button>
      <button type="button" data-action="resetPositions"><i class="fa-solid fa-location-crosshairs"></i><span>{{localize "runyth-tables-of-sustenance.Common.ResetPosition"}}</span></button>
      <button type="button" data-action="resetAll" class="danger"><i class="fa-solid fa-rotate-left"></i><span>{{localize "runyth-tables-of-sustenance.WindowGeometry.ResetAll"}}</span></button>
    </div>
  </section>
</div>
