<div class="rts-transfer-scroll">
  <header class="rts-section-header"><div><h1>{{localize "runyth-tables-of-sustenance.Transfer.Title"}}</h1><p>{{localize "runyth-tables-of-sustenance.Transfer.Intro"}}</p></div></header>
  {{#if isGM}}<form class="rts-transfer-form">
    <section class="rts-tool-panel"><h2>{{localize "runyth-tables-of-sustenance.Transfer.ExportTitle"}}</h2><p>{{localize "runyth-tables-of-sustenance.Transfer.ExportHint"}}</p><div class="rts-check-grid"><label class="checkbox"><input type="checkbox" name="exportSettings" checked><span>{{localize "runyth-tables-of-sustenance.Transfer.Settings"}}</span></label><label class="checkbox"><input type="checkbox" name="exportImages" checked><span>{{localize "runyth-tables-of-sustenance.Transfer.Images"}}</span></label><label class="checkbox"><input type="checkbox" name="exportContent" checked><span>{{localize "runyth-tables-of-sustenance.Transfer.ManagedContent"}}</span></label></div><div class="rts-action-row"><button type="button" data-action="export" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-file-export"></i><span>{{localize "runyth-tables-of-sustenance.Transfer.Export"}}</span></button></div></section>
    <section class="rts-tool-panel"><h2>{{localize "runyth-tables-of-sustenance.Transfer.ImportTitle"}}</h2><p>{{localize "runyth-tables-of-sustenance.Transfer.ImportHint"}}</p><input type="file" accept="application/json,.json" data-rts-import-file hidden><div class="rts-action-row"><button type="button" data-action="chooseFile" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-folder-open"></i><span>{{localize "runyth-tables-of-sustenance.Transfer.ChooseFile"}}</span></button>{{#if preview}}<button type="button" data-action="clear"><i class="fa-solid fa-xmark"></i><span>{{localize "runyth-tables-of-sustenance.Common.Clear"}}</span></button>{{/if}}</div>{{#if preview}}<div class="rts-transfer-preview"><h3>{{localize "runyth-tables-of-sustenance.Transfer.Preview"}}</h3><dl><dt>{{localize "runyth-tables-of-sustenance.Transfer.SourceVersion"}}</dt><dd>{{preview.moduleVersion}}</dd><dt>{{localize "runyth-tables-of-sustenance.Transfer.Settings"}}</dt><dd>{{preview.settings}}</dd><dt>{{localize "runyth-tables-of-sustenance.Transfer.Images"}}</dt><dd>{{preview.imageOverrides}}</dd><dt>{{localize "runyth-tables-of-sustenance.Manager.Foods"}}</dt><dd>{{preview.foods}}</dd><dt>{{localize "runyth-tables-of-sustenance.Manager.Recipes"}}</dt><dd>{{preview.recipes}}</dd><dt>{{localize "runyth-tables-of-sustenance.Manager.Tables"}}</dt><dd>{{preview.tables}}</dd></dl><div class="rts-check-grid"><label class="checkbox"><input type="checkbox" name="importSettings" checked><span>{{localize "runyth-tables-of-sustenance.Transfer.Settings"}}</span></label><label class="checkbox"><input type="checkbox" name="importImages" checked><span>{{localize "runyth-tables-of-sustenance.Transfer.Images"}}</span></label><label class="checkbox"><input type="checkbox" name="importContent" checked><span>{{localize "runyth-tables-of-sustenance.Transfer.ManagedContent"}}</span></label><label class="checkbox warning"><input type="checkbox" name="overwriteContent"><span>{{localize "runyth-tables-of-sustenance.Transfer.OverwriteContent"}}</span></label></div><div class="rts-action-row"><button type="button" data-action="apply" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-file-import"></i><span>{{localize "runyth-tables-of-sustenance.Transfer.Apply"}}</span></button></div></div>{{/if}}</section>
  </form>{{else}}<p class="rts-empty">{{localize "runyth-tables-of-sustenance.Errors.GMOnly"}}</p>{{/if}}
  {{#if report}}<section class="rts-tool-panel"><h2>{{localize "runyth-tables-of-sustenance.Manager.Report"}}</h2><pre class="rts-report">{{reportJson}}</pre></section>{{/if}}
</div>
