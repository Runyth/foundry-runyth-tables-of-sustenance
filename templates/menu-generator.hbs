<div class="obts-generator-layout">
  <form class="obts-generator-form">
    <fieldset><legend>{{localize "runyth-tables-of-sustenance.Generator.Context"}}</legend>
      <label><span>{{localize "runyth-tables-of-sustenance.Browser.Region"}}</span><select name="region"><option value="*">{{localize "runyth-tables-of-sustenance.Common.Any"}}</option>{{#each options.regions}}<option value="{{this}}" {{#if (eq ../config.region this)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
      <label><span>{{localize "runyth-tables-of-sustenance.Generator.Settlement"}}</span><select name="settlement"><option value="*">{{localize "runyth-tables-of-sustenance.Common.Any"}}</option>{{#each options.settlements}}<option value="{{this}}" {{#if (eq ../config.settlement this)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
      <label><span>{{localize "runyth-tables-of-sustenance.Browser.Venue"}}</span><select name="venue"><option value="*">{{localize "runyth-tables-of-sustenance.Common.Any"}}</option>{{#each options.venues}}<option value="{{this}}" {{#if (eq ../config.venue this)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
      <label><span>{{localize "runyth-tables-of-sustenance.Generator.SocialClass"}}</span><select name="socialClass"><option value="*">{{localize "runyth-tables-of-sustenance.Common.Any"}}</option>{{#each options.socialClasses}}<option value="{{this}}" {{#if (eq ../config.socialClass this)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
      <label><span>{{localize "runyth-tables-of-sustenance.Generator.CulturalInfluence"}}</span><select name="culturalInfluence"><option value="*">{{localize "runyth-tables-of-sustenance.Common.Any"}}</option>{{#each options.cultures}}<option value="{{this}}" {{#if (eq ../config.culturalInfluence this)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
      <label><span>{{localize "runyth-tables-of-sustenance.Generator.Prosperity"}}</span><select name="prosperity"><option value="poor">{{localize "runyth-tables-of-sustenance.Generator.Poor"}}</option><option value="ordinary" selected>{{localize "runyth-tables-of-sustenance.Generator.Ordinary"}}</option><option value="wealthy">{{localize "runyth-tables-of-sustenance.Generator.Wealthy"}}</option></select></label>
      <label><span>{{localize "runyth-tables-of-sustenance.Generator.Scarcity"}}</span><select name="scarcity"><option value="normal">{{localize "runyth-tables-of-sustenance.Generator.Normal"}}</option><option value="severe">{{localize "runyth-tables-of-sustenance.Generator.Severe"}}</option></select></label>
      <label><span>{{localize "runyth-tables-of-sustenance.Generator.MilitaryPresence"}}</span><select name="militaryPresence"><option value="normal">{{localize "runyth-tables-of-sustenance.Generator.Normal"}}</option><option value="heavy">{{localize "runyth-tables-of-sustenance.Generator.Heavy"}}</option></select></label>
    </fieldset>
    <fieldset><legend>{{localize "runyth-tables-of-sustenance.Generator.Output"}}</legend><label><span>{{localize "runyth-tables-of-sustenance.Generator.Count"}}</span><input type="number" min="1" max="50" name="count" value="{{config.count}}"></label><label><span>{{localize "runyth-tables-of-sustenance.Generator.MaxTier"}}</span><select name="maxTier"><option value="1">1</option><option value="2" selected>2</option><option value="3">3</option><option value="4">4</option><option value="S">S</option></select></label><label><span>{{localize "runyth-tables-of-sustenance.Generator.PriceMultiplier"}}</span><input type="number" min="0.1" max="10" step="0.1" name="priceMultiplier" value="{{config.priceMultiplier}}"></label><label class="checkbox"><input type="checkbox" name="includeDrinks" {{checked config.includeDrinks}}>{{localize "runyth-tables-of-sustenance.Generator.IncludeDrinks"}}</label><label class="checkbox"><input type="checkbox" name="includeIllicit" {{checked config.includeIllicit}}>{{localize "runyth-tables-of-sustenance.Generator.IncludeIllicit"}}</label><label class="checkbox warning"><input type="checkbox" name="includeLegendary" {{checked config.includeLegendary}}>{{localize "runyth-tables-of-sustenance.Generator.IncludeLegendary"}}</label></fieldset>
    <div class="form-footer"><button type="button" data-action="generate"><i class="fa-solid fa-dice"></i>{{localize "runyth-tables-of-sustenance.Generator.Generate"}}</button><button type="button" data-action="clear"><i class="fa-solid fa-eraser"></i>{{localize "runyth-tables-of-sustenance.Common.Clear"}}</button></div>
  </form>
  <section class="obts-menu-output">{{#if menu}}<header><h2>{{localize "runyth-tables-of-sustenance.Generator.GeneratedMenu"}}</h2>{{#if isGM}}<button type="button" data-action="journal"><i class="fa-solid fa-book"></i>{{localize "runyth-tables-of-sustenance.Generator.CreateJournal"}}</button>{{/if}}</header><div class="obts-table-scroll"><table><thead><tr><th></th><th>{{localize "runyth-tables-of-sustenance.Browser.Name"}}</th><th>{{localize "runyth-tables-of-sustenance.Browser.Tier"}}</th><th>{{localize "runyth-tables-of-sustenance.Browser.Origin"}}</th><th>{{localize "runyth-tables-of-sustenance.Browser.Price"}}</th><th></th></tr></thead><tbody>{{#each menu.rows}}<tr data-source-id="{{sourceId}}"><td><img src="{{img}}" alt=""></td><td>{{name}}</td><td>{{tier}}</td><td>{{origin}}</td><td>{{price}}</td><td><button type="button" data-action="add" class="icon"><i class="fa-solid fa-plus"></i></button></td></tr>{{/each}}</tbody></table></div>{{else}}<p class="obts-empty">{{localize "runyth-tables-of-sustenance.Generator.Empty"}}</p>{{/if}}</section>
</div>
